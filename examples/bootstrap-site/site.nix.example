# Copy to site.nix in a PRIVATE repository; replace documentation addresses/key.
# Generate hardware-configuration.nix from the mounted official-ISO destination.
{
  boot.loader.grub = { enable = true; device = "/dev/vda"; };
  networking = {
    useDHCP = false;
    interfaces.ens18.ipv4.addresses = [{ address = "198.51.100.10"; prefixLength = 24; }];
    defaultGateway = "198.51.100.1";
    nameservers = [ "192.0.2.53" ];
  };
  users.users.root.openssh.authorizedKeys.keys = [ "ssh-ed25519 REPLACE_WITH_REAL_PUBLIC_KEY" ];
  # Only enable after installing /run/secrets/github-runners/qcl-negf from the
  # private site's runtime secret service. Local builds work with this false.
  qclNegf.runner.enable = false;
}

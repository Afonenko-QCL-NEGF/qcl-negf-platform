      scope: [file-content, cached-workers, direct-paths, hooks, vm-transitions, automation]
      reference: {path: null, sha256: null}
    preconditions:
      d04_receipt: {path: null, sha256: null}
      r1r2_receipt: {path: null, sha256: null}
      seed_receipt: {path: null, sha256: null}
      seed_path: null
      seed_sha256: null
      old_installer_unit: null
      old_installer_backing: null
    storage:

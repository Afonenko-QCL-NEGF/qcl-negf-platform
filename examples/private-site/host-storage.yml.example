    path_dev: null
    path_ino: null
    # Optional exact R2-created empty ext4 directory: dev/ino/uid/gid/mode.
    lost_found: null
  cutover:
    enabled: false
    source_ref: null
    window:
      owner: null
      receipt: null
      expires_at_epoch: null

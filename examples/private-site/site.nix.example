# Copy to a private site repository. Supply real, measured addresses and resources.
# These documentation-only addresses are not suitable for an actual deployment.
{
  initializeBlankDisks = false;
  hosts = {
    "192.0.2.10" = [ "storage" ];
    "192.0.2.11" = [ "control" ];
    "192.0.2.12" = [ "compute" ];
    "198.51.100.13" = [ "ci" ];
    "192.0.2.14" = [ "arch-worker" ];
  };
  storageClients = [ "192.0.2.11" "192.0.2.12" "192.0.2.14" ];
  slurm = {
    # Replace CPU counts and RealMemory using `slurmd -C` inside each VM;
    # leave an explicit operating-system reserve. Never use host physical cores
    # as guest logical CPU counts. Example below is a conservative Arch VM cap.
    nodes = [ "arch-worker CPUs=12 RealMemory=28672 State=UNKNOWN" ];
    partitions = [ "compute Nodes=arch-worker Default=YES MaxTime=7-00:00:00 State=UP" ];
  };
}

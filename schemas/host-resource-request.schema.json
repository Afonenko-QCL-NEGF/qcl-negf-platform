{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qcl-negf.org/schemas/host-resource-request.schema.json",
  "title": "QCL host resource demand v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "host_id",
    "vm_id",
    "owner_id",
    "workload_bytes",
    "workload_id"
  ],
  "properties": {
    "schema": { "const": "qcl.host-resource-request.v1" },
    "request_id": { "type": "string", "minLength": 1 },
    "host_id": { "type": "string", "minLength": 1 },
    "vm_id": { "type": "string", "minLength": 1 },
    "owner_id": { "type": "string", "minLength": 1 },
    "workload_bytes": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "workload_id": { "type": "string", "minLength": 1 }
  }
}

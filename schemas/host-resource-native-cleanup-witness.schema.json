{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intent",
    "intent_sha256",
    "phase",
    "worker_birth",
    "cli_birth",
    "cgroup",
    "source_ids",
    "native_peer",
    "claimed_at",
    "terminal_at",
    "local_cleanup_confirmed",
    "result_sha256"
  ],
  "properties": {
    "schema": {
      "const": "qcl.host-resource-native-cleanup-witness.v1"
    },
    "intent": {
      "$ref": "#/$defs/intent"
    },
    "intent_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "phase": {
      "enum": [
        "CLAIMED",
        "RETURNED_SUCCESS"
      ]
    },
    "worker_birth": {
      "$ref": "#/$defs/birth"
    },
    "cli_birth": {
      "$ref": "#/$defs/birth"
    },
    "cgroup": {
      "$ref": "#/$defs/text"
    },
    "source_ids": {
      "$ref": "#/$defs/sources"
    },
    "native_peer": {
      "$ref": "#/$defs/peer"
    },
    "claimed_at": {
      "$ref": "#/$defs/nonnegative"
    },
    "terminal_at": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonnegative"
        },
        {
          "type": "null"
        }
      ]
    },
    "local_cleanup_confirmed": {
      "type": "boolean"
    },
    "result_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "CLAIMED"
          }
        }
      },
      "then": {
        "properties": {
          "terminal_at": {
            "type": "null"
          },
          "result_sha256": {
            "type": "null"
          },
          "local_cleanup_confirmed": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "terminal_at": {
            "$ref": "#/$defs/nonnegative"
          },
          "result_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "local_cleanup_confirmed": {
            "const": true
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Afonenko-QCL-NEGF/qcl-negf-platform/schemas/host-resource-native-cleanup-witness.schema.json",
  "title": "Private exact completed synchronous native mutation witness v1",
  "description": "Structural contract only. Python checks identity joins, exact per-VM uniqueness, digests, trusted current source/peer/worker facts and fresh owned cleanup. No client input or native qualification inferred from this JSON.",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\x00-\\x1f](?:[^\\x00-\\x1f]*[^\\s\\x00-\\x1f])?$"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "protocol": {
      "enum": [
        "libvirt-local-setmem-v1",
        "pve-local-put-balloon-v1"
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00-\\x1f]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "birth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "start_ticks",
        "boot_id"
      ],
      "properties": {
        "pid": {
          "$ref": "#/$defs/positive"
        },
        "start_ticks": {
          "$ref": "#/$defs/positive"
        },
        "boot_id": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vm_id",
        "native_id",
        "process_id",
        "guest_boot_id",
        "image_id",
        "guest_kernel_id",
        "host_kernel_id",
        "qemu_version_id",
        "backend_version_id",
        "readback_version",
        "config_fingerprint"
      ],
      "properties": {
        "vm_id": {
          "$ref": "#/$defs/text"
        },
        "native_id": {
          "$ref": "#/$defs/text"
        },
        "process_id": {
          "$ref": "#/$defs/text"
        },
        "guest_boot_id": {
          "$ref": "#/$defs/text"
        },
        "image_id": {
          "$ref": "#/$defs/text"
        },
        "guest_kernel_id": {
          "$ref": "#/$defs/text"
        },
        "host_kernel_id": {
          "$ref": "#/$defs/text"
        },
        "qemu_version_id": {
          "$ref": "#/$defs/text"
        },
        "backend_version_id": {
          "$ref": "#/$defs/text"
        },
        "readback_version": {
          "$ref": "#/$defs/text"
        },
        "config_fingerprint": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "invocation_id",
        "cgroup",
        "host_boot_id",
        "mutation_id"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "pattern": "^qcl-resource-[0-9a-f]{32}\\.service$"
        },
        "invocation_id": {
          "$ref": "#/$defs/uuid"
        },
        "cgroup": {
          "type": "string",
          "pattern": "^/system.slice/qcl-resource-[0-9a-f]{32}\\.service$"
        },
        "host_boot_id": {
          "$ref": "#/$defs/text"
        },
        "mutation_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "pvePeer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "node",
        "qemu_birth"
      ],
      "properties": {
        "kind": {
          "const": "pve_local"
        },
        "node": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "qemu_birth": {
          "$ref": "#/$defs/birth"
        }
      }
    },
    "libvirtPeer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "socket_path",
        "socket_device",
        "socket_inode",
        "unit",
        "invocation_id",
        "daemon_birth"
      ],
      "properties": {
        "kind": {
          "const": "libvirt_unix"
        },
        "socket_path": {
          "enum": [
            "/run/libvirt/virtqemud-sock",
            "/run/libvirt/libvirt-sock"
          ]
        },
        "socket_device": {
          "$ref": "#/$defs/nonnegative"
        },
        "socket_inode": {
          "$ref": "#/$defs/positive"
        },
        "unit": {
          "enum": [
            "virtqemud.service",
            "libvirtd.service"
          ]
        },
        "invocation_id": {
          "$ref": "#/$defs/uuid"
        },
        "daemon_birth": {
          "$ref": "#/$defs/birth"
        }
      }
    },
    "peer": {
      "oneOf": [
        {
          "$ref": "#/$defs/pvePeer"
        },
        {
          "$ref": "#/$defs/libvirtPeer"
        }
      ]
    },

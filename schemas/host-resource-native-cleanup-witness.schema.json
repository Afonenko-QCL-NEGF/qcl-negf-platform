          "then": {
            "properties": {
              "source_ids": {
                "$ref": "#/$defs/pveSources"
              },
              "native_peer_identity": {
                "$ref": "#/$defs/pvePeer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol_id": {
                "const": "libvirt-local-setmem-v1"
              }
            }
          },
          "then": {
            "properties": {
              "source_ids": {
                "$ref": "#/$defs/libvirtSources"
              },
              "native_peer_identity": {
                "$ref": "#/$defs/libvirtPeer"
              }
            }
          }
        }
      ]
    },
    "qualificationBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profiles"
      ],
      "properties": {
        "schema": {
          "const": "qcl.host-resource-native-mutation-qualifications.v1"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/qualification"
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "helper",
        "qualification",
        "protocol_id"
      ],
      "properties": {
        "schema": {
          "const": "qcl.host-resource-native-cleanup-config.v1"
        },
        "helper": {
          "type": "string",
          "pattern": "^/"
        },
        "qualification": {
          "type": "string",
          "pattern": "^/"
        },
        "protocol_id": {
          "$ref": "#/$defs/protocol"
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "intent",
        "worker_birth"
      ],
      "properties": {
        "schema": {
          "const": "qcl.host-resource-native-dispatch.v1"
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "worker_birth": {
          "$ref": "#/$defs/birth"
        }
      }
    }
  }
}
